# Example environment file for market-backend
# COPY this file to market-backend/.env and fill real values locally (DO NOT commit secrets)

# Use either a mongodb+srv Atlas connection string or a regular mongodb:// URI
# Example Atlas (replace <USER>, <PASSWORD>, <CLUSTER> and <DBNAME>):
# MONGO_URL="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DBNAME>?retryWrites=true&w=majority"

# Example local (docker-compose) URL:
# MONGO_URL="mongodb://mongo:27017"

MONGO_URL=""
DB_NAME=market_db
ALLOW_MONGOMOCK=false
ADMIN_EMAIL=admin@market.com
# Change the default password when you first deploy
ADMIN_PASSWORD=Admin@2026
CORS_ORIGINS=*
